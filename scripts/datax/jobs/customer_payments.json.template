{
  "job": {
    "setting": {
      "speed": {
        "channel": {{CHANNEL}},
        "byte": -1
      },
      "errorLimit": {
        "record": 0,
        "percentage": 0.02
      }
    },
    "content": [
      {
        "reader": {
          "name": "mysqlreader",
          "parameter": {
            "username": "{{SRC_USER}}",
            "password": "{{SRC_PASSWORD}}",
            "column": ["*"],
            "splitPk": "id",
            "connection": [
              {
                "table": ["customer_payments"],
                "jdbcUrl": ["{{SRC_JDBC}}"]
              }
            ]
          }
        },
        "writer": {
          "name": "mysqlwriter",
          "parameter": {
            "writeMode": "{{WRITE_MODE}}",
            "username": "{{TGT_USER}}",
            "password": "{{TGT_PASSWORD}}",
            "column": ["*"],
            "batchSize": 2048,
            {{PRE_SQL_BLOCK}}
            "connection": [
              {
                "jdbcUrl": "{{TGT_JDBC}}",
                "table": ["customer_payments"]
              }
            ]
          }
        }
      }
    ]
  }
}
